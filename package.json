{
  "name": "redhawks",
  "version": "1.0.0",
  "description": "RedHawks Burger & Kebab - Modern React Website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "images": "node scripts/optimize-street-images.mjs",
    "brand-assets": "node scripts/make-brand-assets.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "sharp": "^0.35.5",
    "vite": "^5.0.8",
    "wrangler": "4.151.0"
  }
}
